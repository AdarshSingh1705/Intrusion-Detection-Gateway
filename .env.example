# Gateway
PORT=8080
MONGO_URI=mongodb://mongo:27017/gateway
REDIS_URL=redis://redis:6379
JWT_SECRET=change_me  
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d


# Demo site (the "victim" app the gateway protects)
DEMO_SITE_PORT=4000
DEMO_SITE_ORIGIN_URL=http://demo-site:4000

# Dashboard admin user (created automatically on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Alerting (Brevo — https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
ALERT_SENDER_EMAIL=
ADMIN_ALERT_EMAIL=
